# MySQL 8 low-memory tuning for AMYPO.
#
# The whole stack must fit in 8 GB (API, index, embeddings, LLM, frontend), so
# MySQL is capped at roughly 400-500 MB. The two big levers are the InnoDB buffer
# pool and performance_schema; the rest keeps per-connection buffers small so
# ~50 connections do not add up to hundreds of megabytes.
#
# Mounted by docker-compose at /etc/mysql/conf.d/amypo.cnf.

[mysqld]
# --- memory ---------------------------------------------------------------
innodb_buffer_pool_size = 256M
innodb_log_buffer_size = 8M
innodb_log_file_size = 64M
performance_schema = OFF
max_connections = 50
table_open_cache = 256
table_definition_cache = 400
tmp_table_size = 16M
max_heap_table_size = 16M
sort_buffer_size = 512K
join_buffer_size = 512K
read_buffer_size = 256K
read_rnd_buffer_size = 256K
thread_stack = 256K

# --- durability vs. speed -------------------------------------------------
# The data is seeded from scripts/generate_data.py and can be rebuilt, so we
# trade a little durability for fewer disk flushes: 2 = flush once per second.
innodb_flush_log_at_trx_commit = 2
sync_binlog = 0
skip-log-bin

# --- correctness / defaults ----------------------------------------------
character-set-server = utf8mb4
collation-server = utf8mb4_unicode_ci
default-storage-engine = InnoDB
skip-name-resolve

[client]
default-character-set = utf8mb4
