[TEMPLATE]
# Copy to .env and edit as needed. All variables use the AMYPO_ prefix.

# --- identity / logging -------------------------------------------------
AMYPO_LOG_LEVEL=INFO
AMYPO_LOG_PII=false

# --- MySQL (exact data, chunk text/metadata, logs) ----------------------
AMYPO_MYSQL_HOST=127.0.0.1
AMYPO_MYSQL_PORT=3306
AMYPO_MYSQL_USER=amypo
AMYPO_MYSQL_PASSWORD=amypo
AMYPO_MYSQL_DATABASE=amypo
AMYPO_MYSQL_POOL_SIZE=5
AMYPO_MYSQL_MAX_OVERFLOW=5

# --- retrieval ----------------------------------------------------------
AMYPO_EMBED_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
AMYPO_DENSE_TOP_K=30
AMYPO_BM25_TOP_K=30
AMYPO_FINAL_TOP_K=5
AMYPO_RERANKER=feature            # feature | cross_encoder | none

# --- generation ---------------------------------------------------------
AMYPO_OLLAMA_BASE_URL=http://127.0.0.1:11434
AMYPO_OLLAMA_MODEL=phi3:mini
AMYPO_OLLAMA_FALLBACK_MODEL=tinyllama
AMYPO_OLLAMA_TIMEOUT_S=45
# Force the deterministic stub LLM even when Ollama is running.
AMYPO_STUB_LLM=false
# Disable loading of sentence-transformers / real models entirely.
AMYPO_ALLOW_REAL_MODELS=true

# --- grounding ----------------------------------------------------------
AMYPO_VERIFIER_THRESHOLD=0.55
AMYPO_CLAIM_SIMILARITY_THRESHOLD=0.45

# --- cache --------------------------------------------------------------
AMYPO_CACHE_COSINE=0.92

# --- router -------------------------------------------------------------
AMYPO_RAM_FLOOR_MB=900
AMYPO_RAM_COMFORT_MB=2600
AMYPO_BANDWIDTH_MIN_KBPS=800
AMYPO_LATENCY_BUDGET_MS=6000

# --- simulated cloud (never a real call) --------------------------------
AMYPO_CLOUD_QUOTA_PER_DAY=100
AMYPO_CLOUD_PRICE_INR_PER_CALL=1.75
AMYPO_CLOUD_LATENCY_MS=1800
AMYPO_CLOUD_FAILURE_RATE=0.03

# --- authentication and access control ----------------------------------
# Signing key for the session JWT. Leave empty to generate a random key per
# process (safe, but every restart signs users out). Set a long random value to
# keep sessions across restarts. Never commit the real value.
AMYPO_JWT_SECRET=
AMYPO_ACCESS_TOKEN_TTL_S=900
AMYPO_REFRESH_TOKEN_TTL_S=43200
AMYPO_BCRYPT_ROUNDS=11
# Seed the demo accounts (admin, three staff, one login per student) and show
# the demo-account panel on the login page. Turn off for a real deployment.
AMYPO_DEMO_MODE=true
AMYPO_DEMO_PASSWORD=amypo-demo-2026
# Read-only, public-scope key for the organisers' evaluation harness. Empty
# means "not configured"; the harness then logs in as the seeded `harness` user.
AMYPO_SERVICE_API_KEY=
# Reject requests with no credentials. The login screen is the supported path.
AMYPO_AUTH_REQUIRED=true
AMYPO_LOGIN_MAX_ATTEMPTS=8
AMYPO_LOGIN_WINDOW_S=900

# --- frontend -----------------------------------------------------------
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
# Shows the collapsed demo-account panel on the login screen (build-time flag).
NEXT_PUBLIC_DEMO_MODE=true
